{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pocket",
  "version": "0.2.5",
  "identifier": "app.pocket.companion",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pocket",
        "width": 400,
        "height": 620,
        "minWidth": 360,
        "minHeight": 500,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "maximizable": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "image-viewer",
        "title": "Pocket Image Viewer",
        "width": 900,
        "height": 700,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "skipTaskbar": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "quick-capture",
        "title": "Pocket Capture",
        "width": 620,
        "height": 190,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "center": true,
        "transparent": true,
        "shadow": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      },
      {
        "label": "hud",
        "title": "Pocket HUD",
        "width": 320,
        "height": 88,
        "visible": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "shadow": false,
        "focus": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost https://api.github.com; img-src 'self' data: blob: http://image.localhost https://image.localhost; media-src 'self' data: http://voice.localhost https://voice.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}